#!/bin/zsh

# Remove one known Wi-Fi manual DNS override after network settings change.
# Leave every other manual DNS value untouched.
current_dns=$(/usr/sbin/networksetup -getdnsservers 'Wi-Fi' 2>&1)

if [[ "$current_dns" == '114.114.114.114' ]]; then
  /usr/sbin/networksetup -setdnsservers 'Wi-Fi' Empty
fi
